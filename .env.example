# Cấu hình preview-env-orchestrator.
# Copy file này thành .env rồi chỉnh cho môi trường của bạn.
# File .env THẬT không được commit (đã nằm trong .gitignore).
#
# Lưu ý: file này cũng được Makefile `-include`, nên KHÔNG viết comment
# cùng dòng với "KEY=value" (đặt comment trên dòng riêng như ở đây).

# --- Lưu trữ ---
# STORAGE_DRIVER: memory (in-process, mất khi restart) hoặc postgres.
STORAGE_DRIVER=memory
# DSN Postgres, dùng khi STORAGE_DRIVER=postgres.
DATABASE_URL=postgres://preview:preview@localhost:5432/preview?sslmode=disable

# --- Postgres (docker-compose đọc các biến này để tạo DB) ---
POSTGRES_USER=preview
POSTGRES_PASSWORD=preview
POSTGRES_DB=preview

# --- Docker orchestration ---
# DOCKER_DRIVER: mock (giả lập) hoặc real (gọi Docker Engine SDK thật).
DOCKER_DRIVER=mock

# --- GitHub ---
# GITHUB_DRIVER: mock (in ra console) hoặc real (gọi GitHub REST API).
GITHUB_DRIVER=mock
# Personal access token, cần khi GITHUB_DRIVER=real.
GITHUB_TOKEN=
# Secret cấu hình ở GitHub webhook để xác thực chữ ký X-Hub-Signature-256.
GITHUB_WEBHOOK_SECRET=

# --- OpenTelemetry ---
# Endpoint OTLP/gRPC của collector. Chạy local: localhost:4317.
# Trong docker-compose: jaeger:4317.
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# --- URL công khai ---
# Địa chỉ service này để chèn link "Hủy lệnh xoá" vào comment PR.
PUBLIC_BASE_URL=http://localhost:8080
