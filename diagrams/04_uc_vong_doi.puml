actor "Người dùng preview" as A0
actor "GitHub" as A1
actor "Docker Engine" as A2
rectangle "preview-env-orchestrator" {
usecase "UC-07\nPhát hiện hết TTL" as U0
usecase "UC-08\nGửi cảnh báo" as U1
usecase "UC-09\nHuỷ và gia hạn" as U2
usecase "UC-10\nDọn tài nguyên" as U3
usecase "UC-11\nBáo dọn xong" as U4
